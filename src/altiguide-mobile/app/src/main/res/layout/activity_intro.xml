<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ViewPager2 for sliding intro content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Indicators (dashes) -->
    <LinearLayout
        android:id="@+id/indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp">

        <View
            android:id="@+id/indicator_page1"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/indicator_active" />

        <View
            android:id="@+id/indicator_page2"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/indicator_inactive" />

        <View
            android:id="@+id/indicator_page3"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/indicator_inactive" />
    </LinearLayout>

    <!-- Next / Get Started button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:layout_width="300dp"
        android:layout_height="35dp"
        android:text="Next"
        android:textColor="#374426"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:letterSpacing="0.05"
        android:padding="0dp"
        android:background="@drawable/bg_btn_next"
        android:stateListAnimator="@null"
        android:fontFamily="@font/montserrat_semibold"
        app:layout_constraintBottom_toTopOf="@id/btn_skip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <!-- Skip button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_skip"
        android:layout_width="300dp"
        android:layout_height="35dp"
        android:text="Skip"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:letterSpacing="0.05"
        android:padding="0dp"
        android:background="@drawable/bg_btn_skip"
        android:stateListAnimator="@null"
        android:fontFamily="@font/montserrat_semibold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
