					}
				},
				{
					"name": "Get Mountain Weather",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/mountains/1/weather", "host": [ "{{base_url}}" ], "path": [ "mountains", "1", "weather" ] }
					}
				},
				{
					"name": "Get Routes",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/routes", "host": [ "{{base_url}}" ], "path": [ "routes" ] }
					}
				},
				{
					"name": "Get Route Detail",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/routes/1", "host": [ "{{base_url}}" ], "path": [ "routes", "1" ] }
					}
				},
				{
					"name": "Get Route Weather",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/routes/1/weather", "host": [ "{{base_url}}" ], "path": [ "routes", "1", "weather" ] }
					}
				}
			]
		},
		{
			"name": "4. Transactions (Booking)",
			"item": [
				{
					"name": "Get My Transactions",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/transactions", "host": [ "{{base_url}}" ], "path": [ "transactions" ] }
					}
				},
				{
					"name": "Create Transaction",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"route_id\": 1,\n  \"date\": \"2023-12-01\",\n  \"total_members\": 2,\n  \"members\": [\n    {\n      \"name\": \"Pendaki Utama\",\n      \"nik\": \"3321098765432101\",\n      \"phone\": \"081234567890\",\n      \"is_leader\": true\n    },\n    {\n      \"name\": \"Teman Pendaki\",\n      \"nik\": \"3321098765432102\",\n      \"phone\": \"089876543210\",\n      \"is_leader\": false\n    }\n  ]\n}"
						},
						"url": { "raw": "{{base_url}}/transactions", "host": [ "{{base_url}}" ], "path": [ "transactions" ] }
					}
				},
				{
					"name": "Get Transaction Detail",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/transactions/1", "host": [ "{{base_url}}" ], "path": [ "transactions", "1" ] }
					}
				},
				{
					"name": "Download PDF Invoice",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/transactions/1/pdf", "host": [ "{{base_url}}" ], "path": [ "transactions", "1", "pdf" ] }
					}
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
			}
		},
		{
			"name": "5. Hiking Sessions",
			"item": [
				{
					"name": "Get My Hiking Sessions",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/hiking-sessions", "host": [ "{{base_url}}" ], "path": [ "hiking-sessions" ] }
					}
				},
				{
					"name": "Create Session (Manual)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "transaction_id", "value": "1", "type": "text" }
							]
						},
						"url": { "raw": "{{base_url}}/hiking-sessions", "host": [ "{{base_url}}" ], "path": [ "hiking-sessions" ] }
					}
				},
				{
					"name": "Get Session Detail",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{base_url}}/hiking-sessions/1", "host": [ "{{base_url}}" ], "path": [ "hiking-sessions", "1" ] }
					}
				},
