{
	"info": {
		"_postman_id": "a9a3b9f5-1c32-4b35-8549-8e434f4b1d61",
		"name": "AltiGuide API Collection",
		"description": "Koleksi Postman untuk backend AltiGuide Web.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "name", "value": "Pendaki Baru", "type": "text" },
								{ "key": "email", "value": "pendaki@example.com", "type": "text" },
								{ "key": "phone_number", "value": "081234567890", "type": "text" },
								{ "key": "password", "value": "password123", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/register",
							"host": [ "{{base_url}}" ],
							"path": [ "register" ]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"token\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "email", "value": "pendaki@example.com", "type": "text" },
								{ "key": "password", "value": "password123", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [ "{{base_url}}" ],
							"path": [ "login" ]
						}
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/user",
							"host": [ "{{base_url}}" ],
							"path": [ "user" ]
						}
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "name", "value": "Nama Update", "type": "text" },
								{ "key": "phone_number", "value": "081234567899", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/user/profile",
							"host": [ "{{base_url}}" ],
							"path": [ "user", "profile" ]
						}
					}
				},
				{
					"name": "Change Password",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "current_password", "value": "password123", "type": "text" },
								{ "key": "new_password", "value": "password1234", "type": "text" },
								{ "key": "new_password_confirmation", "value": "password1234", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/user/password",
							"host": [ "{{base_url}}" ],
							"path": [ "user", "password" ]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [ "{{base_url}}" ],
							"path": [ "logout" ]
						}
					}
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
			}
		},
		{
			"name": "2. Forgot Password (OTP)",
			"item": [
				{
					"name": "Send Code",
					"request": {
						"method": "POST",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"body": {
							"mode": "formdata",
							"formdata": [ { "key": "email", "value": "pendaki@example.com", "type": "text" } ]
						},
						"url": { "raw": "{{base_url}}/forgot-password/send-code", "host": [ "{{base_url}}" ], "path": [ "forgot-password", "send-code" ] }
					}
				},
				{
					"name": "Verify Code",
					"request": {
						"method": "POST",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "email", "value": "pendaki@example.com", "type": "text" },
								{ "key": "code", "value": "123456", "type": "text" }
							]
						},
						"url": { "raw": "{{base_url}}/forgot-password/verify-code", "host": [ "{{base_url}}" ], "path": [ "forgot-password", "verify-code" ] }
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "email", "value": "pendaki@example.com", "type": "text" },
								{ "key": "code", "value": "123456", "type": "text" },
								{ "key": "password", "value": "newpassword123", "type": "text" },
								{ "key": "password_confirmation", "value": "newpassword123", "type": "text" }
							]
						},
						"url": { "raw": "{{base_url}}/forgot-password/reset", "host": [ "{{base_url}}" ], "path": [ "forgot-password", "reset" ] }
					}
				}
			]
		},
		{
			"name": "3. Catalog & Information",
			"item": [
				{
					"name": "Get Mountains",
